{
  "name": "groundtrace-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "GroundTrace \u2014 trace any displayed UI value back to its real source.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "demo": "pnpm --filter dashboard-demo dev",
    "clean": "rm -rf packages/*/dist examples/*/.next"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
