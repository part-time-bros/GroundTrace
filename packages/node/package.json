{
  "name": "@groundtrace/node",
  "version": "0.1.0",
  "description": "GroundTrace server SDK: request-scoped provenance tracking for Node (Next.js route handlers, SQLite queries, fetch).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@groundtrace/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
