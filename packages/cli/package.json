{
  "name": "groundtrace",
  "version": "0.1.0",
  "description": "GroundTrace CLI: verify what your app actually shows, instead of trusting 'Done ✅'.",
  "keywords": [
    "groundtrace",
    "provenance",
    "data-lineage",
    "debugging",
    "observability",
    "cli",
    "verification",
    "ci",
    "ai-agents"
  ],
  "homepage": "https://github.com/part-time-bros/GroundTrace#readme",
  "bugs": {
    "url": "https://github.com/part-time-bros/GroundTrace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/part-time-bros/GroundTrace.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "groundtrace": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@groundtrace/core": "workspace:*",
    "@groundtrace/node": "workspace:*",
    "@groundtrace/overlay": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
