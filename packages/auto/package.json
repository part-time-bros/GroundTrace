{
  "name": "@groundtrace/auto",
  "version": "0.1.0",
  "description": "Zero-config GroundTrace: tags displayed values by matching them against traced sources, with no useTruthValue calls.",
  "keywords": [
    "groundtrace",
    "provenance",
    "data-lineage",
    "debugging",
    "observability",
    "instrumentation",
    "zero-config",
    "auto-instrumentation"
  ],
  "homepage": "https://github.com/part-time-bros/GroundTrace#readme",
  "bugs": {
    "url": "https://github.com/part-time-bros/GroundTrace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/part-time-bros/GroundTrace.git",
    "directory": "packages/auto"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@groundtrace/core": "workspace:*",
    "bippy": "^0.6.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
