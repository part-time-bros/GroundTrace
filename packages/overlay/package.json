{
  "name": "@groundtrace/overlay",
  "version": "0.1.0",
  "description": "GroundTrace browser overlay: click a [data-truth-id] element, see its provenance tree.",
  "keywords": [
    "groundtrace",
    "provenance",
    "data-lineage",
    "debugging",
    "observability",
    "devtools",
    "overlay",
    "browser"
  ],
  "homepage": "https://github.com/part-time-bros/GroundTrace#readme",
  "bugs": {
    "url": "https://github.com/part-time-bros/GroundTrace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/part-time-bros/GroundTrace.git",
    "directory": "packages/overlay"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./overlay.global.js": "./dist/overlay.global.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@groundtrace/core": "workspace:*",
    "bippy": "^0.6.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
