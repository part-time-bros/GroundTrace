{
  "name": "@groundtrace/vue",
  "version": "0.1.0",
  "description": "GroundTrace Vue SDK: mark a rendered value as tracked, tag its DOM node, trace it back to its source.",
  "keywords": [
    "groundtrace",
    "provenance",
    "data-lineage",
    "debugging",
    "observability",
    "vue",
    "composables",
    "devtools"
  ],
  "homepage": "https://github.com/part-time-bros/GroundTrace#readme",
  "bugs": {
    "url": "https://github.com/part-time-bros/GroundTrace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/part-time-bros/GroundTrace.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@groundtrace/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vue": "^3.5.41"
  },
  "publishConfig": {
    "access": "public"
  }
}
